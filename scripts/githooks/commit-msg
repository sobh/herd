#!/bin/sh
# commit-msg
#
# Description:
#   Validate the commit subject against Conventional Commits:
#     type(scope): subject   or   type: subject
#   with a lowercase subject start, an optional "!" for breaking changes, and
#   at most 72 characters. Merge, revert, fixup, and squash subjects generated
#   by git are accepted as-is.
#
# Usage:
#   commit-msg <message-file>   (called by git)
#
# Exit codes:
#   0  Valid subject
#   1  Invalid subject; the commit is rejected

message_file=$1
subject=$(sed -n '1p' "$message_file")

# Subjects generated by git itself.
case $subject in
'Merge '* | 'Revert "'* | 'fixup! '* | 'squash! '* | 'amend! '*)
	exit 0
	;;
esac

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
pattern="^($types)(\([a-z0-9_/.-]+\))?!?: [a-z0-9].*[^.]$"
max_length=72

problem=""
if ! printf '%s\n' "$subject" | grep -Eq -- "$pattern"; then
	problem="does not follow the conventional format"
elif [ "${#subject}" -gt "$max_length" ]; then
	problem="is longer than $max_length characters (${#subject})"
fi

if [ -n "$problem" ]; then
	printf '❌ Commit subject %s.\n' "$problem" >&2
	printf '\tExpected: type(scope): subject   (scope optional)\n' >&2
	printf '\tTypes:    %s\n' "$(printf '%s' "$types" | sed 's/|/, /g')" >&2
	printf '\tRules:    lowercase start, no trailing period, <= %s chars\n' \
		"$max_length" >&2
	printf '\tGot:      %s\n' "$subject" >&2
	exit 1
fi
