# The Linux keycodes are defined in:
#   /usr/include/linux/input-event-codes.h
#
# The format of each line in the block body is:
#   KEYBOARD_KEY_<scancode>=<keycode>.
#
# The value of <scancode> is hexadecimal, but without the leading 0x
# (i.e. specify a0 instead of 0xa0), whereas the value of <keycode> is the
# lower-case keycode name string as listed in:
#   /usr/include/linux/input-event-codes.h
#
# See the KEY_<KEYCODE> variables), a sorted list is available at:
#       https://hal.freedesktop.org/quirk/quirk-keymap-list.txt
#
# It is not possible to specify decimal value in <keycode>
#

# Remap common keys for all AT keyboards (i.e. Laptops)
evdev:atkbd:*
 KEYBOARD_KEY_01=capslock       #   1 Escape        => CapsLock
 KEYBOARD_KEY_3a=esc            #  58 CapsLock      => Escape
 KEYBOARD_KEY_7d=leftalt        # 125 Left-Meta     => Left-Alt
 KEYBOARD_KEY_38=leftmeta       #  56 Left-Alt      => Left-Meta
 KEYBOARD_KEY_61=rightctrl      #  97 Right-Ctrl    => Right-Alt
 KEYBOARD_KEY_64=rightalt       # 100 Right-Alt     => Right-Ctrl
